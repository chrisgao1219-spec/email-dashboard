# Vercel serverless proxy configuration
GAS_DEPLOY_ID=your-google-apps-script-deploy-id
GAS_API_KEY=your-server-side-gas-api-key

# Local Vite dev proxy fallback only. Do not configure this in Vercel.
VITE_GAS_DEPLOY_ID=your-google-apps-script-deploy-id
VITE_API_KEY=

# AI 审核（DeepSeek）— 用于评分、文案改写、邮件 HTML 审核等
DEEPSEEK_API_KEY=your-deepseek-api-key
